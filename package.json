{
  "name": "my-ide",
  "version": "1.0.0",
  "description": "My IDE — WhatsApp-authenticated web dashboard with files, git, terminal, previews, n8n, and database tools",
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npx tsx src/index.ts",
    "dev": "npx tsx watch src/index.ts",
    "dev:all": "concurrently -n bridge,dashboard -c blue,green \"npm run dev\" \"npm run dev:dashboard\"",
    "setup": "npx tsx scripts/setup.ts",
    "build:dashboard": "npm install --prefix src/dashboard/client --legacy-peer-deps && npm run build --prefix src/dashboard/client",
    "dev:dashboard": "npm run dev --prefix src/dashboard/client",
    "capture:video": "npx tsx scripts/capture-dashboard-for-video.ts",
    "typecheck:backend": "tsc --project tsconfig.backend.json --noEmit",
    "typecheck:client": "npm run typecheck --prefix src/dashboard/client",
    "typecheck": "npm run typecheck:backend && npm run typecheck:client",
    "typecheck:dashboard": "npm run typecheck:client",
    "typecheck:all": "npm run typecheck",
    "check:no-new-ts-nocheck": "npx tsx scripts/check-no-new-ts-nocheck.ts",
    "check:ts-nocheck-budget": "npx tsx scripts/check-no-new-ts-nocheck.ts --enforce-budget",
    "check:write-ts-nocheck-allowlist": "npx tsx scripts/check-no-new-ts-nocheck.ts --write-allowlist",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:agent": "npx tsx scripts/agent-eval-mastra.ts",
    "eval:promptfoo": "promptfoo eval -c evals/agent/promptfooconfig.yaml",
    "mcp:agent-tools": "npx tsx scripts/agent-mcp-server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.74",
    "@ai-sdk/openai": "^3.0.58",
    "@huggingface/transformers": "^3.0.0",
    "@mastra/core": "^1.31.0",
    "@mastra/fastembed": "^1.0.1",
    "@mastra/libsql": "^1.9.1",
    "@mastra/memory": "^1.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "fast-glob": "^3.3.3",
    "ffmpeg-static": "^5.2.0",
    "helmet": "^8.1.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "mysql2": "^3.11.0",
    "node-pty": "^1.1.0",
    "pg": "^8.13.0",
    "pino": "^9.0.0",
    "puppeteer": "^24.0.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "sqlite-vec": "^0.1.9",
    "wavefile": "^11.0.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.1",
    "@types/pg": "^8.11.0",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "eslint": "^10.0.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "promptfoo": "^0.121.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0"
  }
}
