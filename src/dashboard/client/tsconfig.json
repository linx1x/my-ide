{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@dashboard/pipeline-heuristics": ["../pipeline-heuristics.ts"],
      "@dashboard/pipeline-phase-ids": ["../pipeline-phase-ids.ts"]
