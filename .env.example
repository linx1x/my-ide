# Your WhatsApp number (required) - country code, no + needed (spaces and + are stripped)
# The bridge only accepts messages from these numbers and uses WhatsApp for dashboard OTP login.
# ALLOWED_NUMBERS=33612345678

# Dashboard/codebase workspace. Defaults to the bridge project root.
# DASHBOARD_WORKDIR=/path/to/your/project

# Max WhatsApp message length before splitting (default: 4000)
# MAX_REPLY_LENGTH=4000

# WhatsApp reply helpers
# WHATSAPP_PROMPT_PREFIX=1
# SCREENSHOT_ENABLED=1

# Voice messages (default: on) - transcribe voice notes to text.
# VOICE_ENABLED=1
# GROQ_API_KEY=gsk_...
# VOICE_PROVIDER=groq
# OPENAI_API_KEY=sk-...
# WHISPER_MODEL=

# AI agent providers (chat/runtime foundation)
# AGENT_DEFAULT_PROVIDER=openai
# AGENT_DEFAULT_MAX_TOKENS=4096
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-5.4-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-4-6
# QWEN_API_KEY=sk-...
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.6-plus

# Mastra dashboard chat (SSE). Requires matching provider API key.
# AGENT_CHAT_ENABLED=1
# AGENT_TEAM_MODE=0
# AGENT_MEMORY_SEMANTIC=1
# AGENT_RUNTIME_DB=
# AGENT_MASTRA_LIBSQL_URL=file:/absolute/path/to/mastra-memory.db

# Dashboard
# DASHBOARD_ENABLED=1
# DASHBOARD_PORT=3847
# DASHBOARD_SECRET=your-secret-for-jwt
# DASHBOARD_CODEBASE_ROOT=__app__  # mirror bridge itself. Unset = DASHBOARD_WORKDIR
# DASHBOARD_CORS_ORIGIN=https://your-dashboard.example.com
# DASHBOARD_GIT_STATUS_POLL_MS=4000
# DASHBOARD_BASE_URL=http://localhost:3847
# CUSTOM_DOMAIN=dashboard.example.com

# Cloudflare Tunnel
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
# CLOUDFLARE_CREDENTIALS_DIR=C:\Users\<you>\.cloudflared
# TUNNEL_ID=your-tunnel-id
# TUNNEL_HOSTNAME=dashboard.example.com

# Terminal
# TERMINAL_SSH_ENABLED=0

# DB visualizer
# DASHBOARD_DB_CONNECTION_IDLE_MS=1800000
# DASHBOARD_DB_MAX_CONNECTIONS_PER_USER=5
# DASHBOARD_DB_MAX_TOTAL_CONNECTIONS=50

# Project clone jobs
# PROJECT_JOBS_MAX_ENTRIES=50
# PROJECT_JOBS_FINISHED_RETENTION_MS=900000

# n8n embedded (optional)
N8N_ENABLED=1
N8N_INTERNAL_URL=http://localhost:5678
# N8N_WORKFLOW_BRIDGE_BASE_URL=http://host.docker.internal:3847
# N8N_WORKFLOW_USE_LOOPBACK_FOR_N8N=1
# N8N_PUBLISH_PORT=5678
N8N_PUBLIC_PATH=/n8n
# N8N_EDITOR_BASE_URL=http://localhost:3847/n8n/
# WEBHOOK_URL=http://localhost:3847/n8n/
# N8N_HOST=localhost
# N8N_PROTOCOL=http
# N8N_API_KEY=n8n_api_...
N8N_UI_EMBED_MODE=iframe

# LangFuse UI embedded in dashboard (reverse proxy)
# LANGFUSE_UI_ENABLED=1
# LANGFUSE_UI_INTERNAL_URL=http://localhost:3000
# LANGFUSE_UI_PUBLIC_PATH=/langfuse
# LANGFUSE_NEXTAUTH_URL=https://your-domain.com/langfuse
# LANGFUSE_NEXTAUTH_SECRET=changeme-nextauth-secret
# LANGFUSE_SALT=changeme-salt
# LANGFUSE_ENCRYPTION_KEY=deadbeefcafebabe1234567890abcdef1234567890abcdef1234567890abcdef
# LANGFUSE_CLICKHOUSE_PASSWORD=clickhouse
# LANGFUSE_INIT_EMAIL=admin@my-ide.local
# LANGFUSE_INIT_NAME=Admin
# LANGFUSE_INIT_PASSWORD=changeme123!

# Security
# PROTECTED_BRANCHES=main,master,develop,production
# ALLOWED_PUSH_PREFIXES=feature/,fix/,hotfix/,chore/,release/,refactor/

# GitHub Workflow panel
# GITHUB_WORKFLOW_ENABLED=1
# GITHUB_TOKEN=ghp_xxx

# Docker / SaaS
# BRIDGE_DATA_DIR=/var/lib/my-ide

# Preview (IDE iframe)
# PREVIEW_TEMP_DIR=
# PREVIEW_PORT_MIN=5173
# PREVIEW_PORT_MAX=5199
# PREVIEW_IDLE_TIMEOUT_MS=1800000
# PREVIEW_MATERIALIZE_TIMEOUT_MS=120000
# PREVIEW_READY_TIMEOUT_MS=90000
# PREVIEW_PROXY_HOST=127.0.0.1
# PREVIEW_TERMINAL_PORT=5173

# SkillsMP (optional)
# SKILLSMP_API_KEY=sk_live_...

# Discord (optional)
# DISCORD_ENABLED=1
# DISCORD_BOT_TOKEN=your_bot_token_from_discord_com_developers
# DISCORD_ALLOWED_CHANNEL_IDS=channel_id_1,channel_id_2
