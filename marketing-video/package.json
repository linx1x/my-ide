{
  "name": "marketing-video",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts",
    "render": "remotion render src/index.ts MarketingVideo out/marketing.mp4",
    "render:matrix-birthday": "remotion render src/index.ts MatrixBirthday out/matrix-birthday.mp4",
    "render:matrix-birthday-gif": "remotion render src/index.ts MatrixBirthday out/matrix-birthday.gif --codec=gif --every-nth-frame=1 --scale=0.65 --overwrite"
  },
  "dependencies": {
    "@remotion/bundler": "^4.0.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "@remotion/media": "^4.0.438",
    "@remotion/transitions": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "typescript": "^5.0.0"
  }
}
